# ESP-IDF 构建产物与组件缓存(可再生成)
firmware/build*/
firmware/managed_components/
firmware/dependencies.lock
# 本地配置: 含真实 WiFi 凭据, 不入库(经 menuconfig 填写)
# (分目标本地文件逐个列名; sdkconfig.defaults* 是入库的配置骨架, 勿加通配)
firmware/sdkconfig
firmware/sdkconfig.p4c5
firmware/sdkconfig.s31
firmware/sdkconfig.old
# 测试音频素材(大体积二进制, 脚本可再生)
testaudio/
# 证书与私钥: 配对调试 CA 由 tools/gen_pair_certs.sh 本地生成, 私钥绝不入库
tools/certs/
# Python 缓存
__pycache__/
*.pyc
# ZCode 会话产物(工具生成, 不入库)
.zcode/
# 编辑器
.vscode/
# 系统杂物
*.swp
.DS_Store
# Kiro AI 会话/规格目录(2026-11-18 用户裁决: 了解后整体移除, 不入库)
.kiro/
# EFC 源材料(乐鑫 Modified MIT 再分发限制+体积): 本地放置不入库(tools/efc_build 可重建)
tools/efc/*.zip
tools/efc/gif/
tools/efc/out/

# App 验证用下载物(APK 等二进制, 不入库)
dist/

# 素材出库(§55.20 用户裁决): .efc 表情与 media/ 参考素材不入库(来源许可未定,
# vendor-licenses.md §3); 本地放置后构建自动嵌入, 获取见 tools/fetch_face_assets.sh
firmware/components/app_ui/ui/assets/face/*
!firmware/components/app_ui/ui/assets/face/MANIFEST.json
media/

# ============ EspCube sdkconfig 公共默认值(S31 + P4C5 双目标) ============
# 分目标叠加文件: sdkconfig.defaults.esp32s31 / sdkconfig.defaults.esp32p4
# (IDF 按 IDF_TARGET 自动加载); 板卡选择见 Kconfig ESP_CUBE_BOARD。
# 说明: 若个别选项名在 v6.1 中有变化, 编译时会以警告忽略, 届时按 menuconfig 实际项修正。

# ---- 主频/系统(主频值在分目标文件) ----
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_INT_WDT_TIMEOUT_MS=500
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# ---- Flash(两板均 16MB QIO@80M; P4 另加 Boya 芯片支持与 no-stub) ----
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y

# ---- PSRAM 公共(模式在分目标文件: S31=OCT 16MB / P4=HEX 32MB) ----
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y

# ---- 网络(跨境流媒体吞吐 = 窗口/RTT, 见 S31 实测注释) ----
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=24
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=8192
CONFIG_LWIP_TCP_WND_DEFAULT=10240
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=10240

# ---- 显示(LVGL via esp_lvgl_port): 全帧双缓冲防撕裂由 disp flags 控制 ----
CONFIG_LVGL_PORT_TASK_STACK_SIZE=32768
CONFIG_LVGL_PORT_TASK_AFFINITY_CPU1=y
CONFIG_LV_FONT_MONTSERRAT_24=y

# ---- LVGL 9.6 编译前置(新氛围 UI; 与 sim/lv_conf.h 对齐) ----
# 字体内置 malloc 池仅 64KB, 歌词旋转 snapshot 需大块分配 → CLIB
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_SNAPSHOT=y
CONFIG_LV_FONT_FMT_TXT_LARGE=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_28=y

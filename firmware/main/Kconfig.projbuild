menu "EspCube Configuration"

    # ============ 板卡选择(引脚/外设映射分派, boardcfg 唯一登记处) ============
    choice ESP_CUBE_BOARD
        prompt "板卡型号"
        default ESP_CUBE_BOARD_S31 if IDF_TARGET_ESP32S31
        default ESP_CUBE_BOARD_P4C5 if IDF_TARGET_ESP32P4
        help
          同一代码库支持双目标: 引脚映射与板级能力常量由
          boardcfg/components 的 board_pins_s31.h / board_pins_p4c5.h 分派。

    config ESP_CUBE_BOARD_S31
        bool "EspCube 核心板(ESP32-S31-WROOM-3, QSPI AMOLED)"

    config ESP_CUBE_BOARD_P4C5
        bool "鱼鹰光电 OSPTEK ESP32-P4C5 开发板(MIPI-DSI AMOLED + C5 WiFi)"
    endchoice

    # ============ 功能开关(里程碑式启用) ============
    config ESP_CUBE_ENABLE_BT
        bool "启用蓝牙 A2DP Sink(手机蓝牙音乐)"
        depends on IDF_TARGET_ESP32S31
        default y
        help
          P4 无蓝牙控制器, 该选项仅在 S31 目标存在(不定义时
          代码中 #if 自动为假, app_bt 整体不参与编译)。

    config ESP_CUBE_NET_HOSTED
        bool "WiFi 经 C5 共芯(esp_hosted, SDIO 透传)"
        depends on ESP_CUBE_ENABLE_NET
        default y if IDF_TARGET_ESP32P4
        default n
        help
          P4 无原生射频: WiFi 由 C5 经 SDIO/esp_hosted 提供,
          esp_wifi API 经 esp_wifi_remote 透传, 上层无感。

    config ESP_CUBE_ENABLE_PROV
        bool "启用 SoftAP 首配通道(P3a; network_provisioning Security2)"
        depends on ESP_CUBE_ENABLE_NET
        default y
        help
          官方配网协议(protocomm SoftAP + SRP-6a), 与 P3b App 及
          官方 ESP Provisioning app 互通。CLI "prov start" 开窗,
          随机 6 位 PIN, 超时自动回落 STA。凭据落 C5 NVS(P4 经
          esp_wifi_remote 透传), 开机既有配置优先于 Kconfig 注入。

    config ESP_CUBE_ENABLE_NET
        bool "启用 WiFi + 网络电台播放"
        default y

    config ESP_CUBE_ENABLE_UI
        bool "启用 AMOLED UI(LVGL)"
        default y

    config ESP_CUBE_ENABLE_VOICE
        bool "启用语音前端(esp-sr: 唤醒/AEC/命令词)[里程碑2]"
        default n
        help
          需要先在 main/idf_component.yml 中取消 esp-sr 依赖注释,
          并烧录 model 分区(srmodels)。详见 docs/02_详细设计.md §5。

    config ESP_CUBE_ENABLE_AI
        bool "启用 AI 云端会话(百炼: LLM+TTS, 可选 ASR)"
        default n
        help
          移植自 Kaleido kaleido_speech(V-33 真机验证)。一把阿里云 key
          全包(LLM qwen/TTS cosyvoice/ASR paraformer)。key 只进本地
          sdkconfig(不入库, 与 WiFi 凭据同红线)。
          2026-11 起不依赖 VOICE: 文本注入(CLI ask)即可驱动 LLM+TTS
          (语音 ASR 入口需另开 VOICE)。含 function calling 技能循环
          (ai_skills 注册表, L5 注入)。

    config ESP_CUBE_ENABLE_FACE_ANIM
        bool "启用表情动画(esp_efc_codec, 乐鑫官方情绪素材)"
        default n
        depends on ESP_CUBE_ENABLE_UI
        select ESP_EFC_LVGL_WIDGET
        help
          Emote Frame Codec(乐鑫): RGB565 无损 tile 编码动画, LVGL
          lv_efc 控件承载。P4C5 推荐(32MB PSRAM + PPA 硬件缩放),
          当前仅 sdkconfig.defaults.esp32p4 默认开。esp_efc_codec 仅
          P4 目标引入(idf_component.yml rules), S31 不引入。本项
          select CONFIG_ESP_EFC_LVGL_WIDGET(组件默认 n)。

    config ESP_CUBE_FACE_PERF
        bool "表情帧耗时观测(faceperf: lv_efc 帧 D、显示 R/F、分位数报告)"
        depends on ESP_CUBE_ENABLE_FACE_ANIM
        default y if ESP_CUBE_ENABLE_FACE_ANIM
        default n
        help
          只观测, 不改 UI 行为: 开机窗(splash、首刷、屏幕自检 lit)与 CLI
          faceperf start/report/stop。样本缓冲走 PSRAM, 测量时分配、测完释放。
          依赖表情开关, 关闭表情时整段不编译(face_perf.c、face_perf_stats.c)。

    # ---- AI 云配置(BYOK, 只进本地 sdkconfig) ----
    config ESP_CUBE_AI_API_KEY
        string "阿里云百炼 API Key(DASHSCOPE)"
        default "sk-your-key"

    config ESP_CUBE_AI_ASR_MODEL
        string "ASR 模型(paraformer 实时流)"
        default "paraformer-realtime-v2"

    config ESP_CUBE_AI_LLM_MODEL
        string "LLM 模型(OpenAI 兼容)"
        default "qwen-plus"

    config ESP_CUBE_AI_LLM_URL
        string "LLM 端点(OpenAI 兼容 /chat/completions 全 URL)"
        default "https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions"
        help
            任意 OpenAI 兼容厂家均可: DeepSeek(api.deepseek.com/v1/...),
            Kimi(api.moonshot.cn/v1/...), 智谱(open.bigmodel.cn/api/paas/v4/...),
            MiniMax(api.minimax.chat/v1/text/chatcompletion_v2), 火山方舟
            (ark.cn-beijing.volces.com/api/v3/...)。五家链根(DigiCert G2/
            Sectigo R46)均在 IDF 默认证书束内, 2026-11-12 实测可达。

    config ESP_CUBE_AI_RT_ENABLE
        bool "快线: qwen-omni realtime 即兴应答(B3 快慢路径)"
        default n
        help
            语音进语音出常驻连接(server_vad 自动应答), 负责即兴语音/
            注入播报; 工具可靠性仍由慢线(paraformer+文本 LLM FC)保证。
            失联自动回落纯级联三段链("一根线都不拆")。需配套 RT_* 配置。

    config ESP_CUBE_AI_RT_MODEL
        string "快线模型"
        default "qwen3.8-omni-flash-realtime"
        depends on ESP_CUBE_AI_RT_ENABLE

    config ESP_CUBE_AI_RT_VOICE
        string "快线音色(Tina/Serena/复刻ID)"
        default "Serena"
        depends on ESP_CUBE_AI_RT_ENABLE

    config ESP_CUBE_AI_RT_URL
        string "快线端点(Realtime WS 全 URL)"
        default "wss://dashscope.aliyuncs.com/api-ws/v1/realtime"
        depends on ESP_CUBE_AI_RT_ENABLE

    config ESP_CUBE_AI_TOOL_FAST_ACK
        bool "技能成功回执直喂 TTS(跳过第二轮 LLM, 首响 -1s)"
        default y
        help
            工具执行成功后, 回执文本("正在播放:《X》- Y")直接进 TTS,
            不再发起第二轮 LLM 生成自然语言回应。音箱品类惯例(小爱/
            小度同款), 省 1s 延迟与 token; 关闭则回复更自然但更慢。

    config ESP_CUBE_AI_LLM_DISABLE_THINKING
        bool "LLM 请求附 thinking disabled(百炼 qwen3 系列专用)"
        default y
        help
            DashScope qwen3 系列 stream 下需显式关闭思考模式; 换其他
            厂家(DeepSeek/GLM/Kimi 等)设 n, 避免多余字段被拒。

    config ESP_CUBE_AI_LLM_SYSTEM
        string "LLM 系统提示词(角色人格, 可空)"
        default "你是贴心的桌面语音助理, 能点歌放电台、记琐事、定提醒、闲聊陪伴与情绪疏导。回答简洁口语化, 不超过三句话。"

    config ESP_CUBE_AI_TTS_MODEL
        string "TTS 模型(cosyvoice)"
        default "cosyvoice-v3-flash"

    config ESP_CUBE_AI_TTS_VOICE
        string "TTS 音色"
        default "longanrou_v3"
        help
          2026-11-12 板上甄选(8 款连播试听, 用户定): 女声 longanrou_v3
          (温柔闺蜜)出厂默认(2026-11-12 三听终选); 男声备选 longanyang(阳光大男孩, 支持
          Instruct)。CLI `voice <名>` 运行时热切, 后续进 persona.json。
          v3-flash 音色名须带 _v3 后缀(v2 命名被 Engine 418 拒绝)。

    config ESP_CUBE_AI_TTS_RATE
        int "TTS 输出采样率(16000/24000)"
        default 16000

    config ESP_CUBE_ENABLE_SD
        bool "SD 卡存储服务(TF 卡槽 SDMMC, 记忆系统底座)"
        default y if ESP_CUBE_BOARD_P4C5
        default n
        depends on IDF_TARGET_ESP32P4
        help
            底板 TF 卡槽(microSD, slot0 GPIO39-44, 与 C5 WiFi 独立)。
            /sdcard: mem(记忆)/face(表情素材)/wake(唤醒词模型)/
            voice(复刻参考)/etc(人格配置)/logs。无卡优雅降级
            (记忆回退 NVS, 素材回退 flash 内置)。

    config ESP_CUBE_ENABLE_SOUL
        bool "灵魂内核(驱力+三层栈情绪(trait→mood→emotion)+SD 记忆, 移植 Kaleido)"
        default y
        depends on ESP_CUBE_ENABLE_AI
        help
            1Hz 确定性情感动力学: 三驱力内稳态(social/stim/rest) →
            感受态(valence/mood/arousal/...) → 每轮 LLM prompt 注入
            内在状态 + mood 标签回写 + TTS 语速/音高调制 + UI 情绪
            事件; 附轻量情节记忆(SD 持久化, 缺卡不写 A-01)。关闭则全部旁路。

    config ESP_CUBE_SOUL_PROACTIVE
        bool "主动交互(点火: 闲置时主动搭话)"
        default n
        depends on ESP_CUBE_ENABLE_SOUL
        help
            Kaleido ignition 防打扰框架: 五因子打分 + 勿扰时段 +
            日配额 + 冷静期, 触发后 LLM 深思单句 → 带外播报。
            默认关(验收后再开, 避免意外说话)。

    config ESP_CUBE_SOUL_BOOT_RADIO
        bool "开机电台反射(联网即自娱放歌)"
        default y
        depends on ESP_CUBE_ENABLE_SOUL
        help
            AI-first 架构(docs/14): 原装配层"WIFI 就绪自动播电台"演示
            行为移交灵魂 L0 反射 —— 联网边沿且未在播且未退避(用户手动
            停台 2h 内)则放歌。关闭 = 开机完全安静, 音乐只由评分器
            (无聊自娱)或深思或用户指令触发。SOUL 未启用目标(S31)
            仍走 main.c 旧自启路径。

    # ============ 网络 ============
    config ESP_CUBE_WIFI_SSID
        string "WiFi SSID(原型期经 menuconfig 填写; 凭据不入库, M3 改为配网)"
        default "your-ssid"

    config ESP_CUBE_WIFI_PASSWORD
        string "WiFi 密码"
        default "your-password"

    config ESP_CUBE_DEFAULT_STATION
        string "默认网络电台 URL"
        default "http://ice1.somafm.com/indiepop-128-mp3"
        help
          MP3 128k 流, 用于 M1 验证网络音频链路。

    # ============ 音频 ============
    config ESP_CUBE_TEST_TONE
        bool "播放440Hz测试音(绕过解码器, 验证DAC/功放/喇叭链路)"
        default n
        help
          注意: LUT 相位步进有已知笔误, 实际输出频率约 10kHz 而非 440Hz,
          仅用于链路通断验证, 不要长开。

    config ESP_CUBE_AUDIO_DEBUG
        bool "音频链路调试日志(输出幅度/音源缓冲水位/读取探针)"
        default n

    config ESP_CUBE_DISPLAY_DEBUG
        bool "显示首亮调试(彩条停留3秒观察窗)"
        default n

    config ESP_CUBE_LCD_SINGLE_LANE_TEST
        bool "屏幕单线(3-wire)点亮自检(GPIO位压彩条, 不经QSPI)"
        depends on IDF_TARGET_ESP32S31
        default n
        help
            排查杜邦线/四线数据通路用(docs/05): 固件启动时先用 3-wire
            9-bit 位压波形点亮六色彩条(约10秒), 再继续正常 QSPI 初始化。
            彩条出现 = D0/CLK/CS/RST 全通。

    config ESP_CUBE_MIXER_RATE
        int "混音引擎采样率(Hz)"
        default 48000
        range 16000 96000

    config ESP_CUBE_BT_SRC_RATE
        int "蓝牙A2DP解码输出采样率(Hz)"
        depends on ESP_CUBE_ENABLE_BT
        default 44100
        range 16000 48000
        help
          Bluedroid 内置 SBC 解码器输出采样率(手机默认协商 44100)。
          若实测发现手机协商 48k, 此处改为 48000;
          M2 将切换为外置 SBC 解码模式, 从协商参数自动获取。

    config ESP_CUBE_NET_PREFILL_MS
        int "网络音源预填充时长(ms)"
        default 1000
        help
          解码余量充足(约26倍实时)时 1000ms 即可平滑;
          若换回慢源(如跨境电台)建议 3000。

    config ESP_CUBE_DEFAULT_VOLUME
        int "默认音量(0-100)"
        default 45

    # ============ 显示 ============
    config ESP_CUBE_LCD_PIXEL_CLOCK_HZ
        int "QSPI 像素时钟(Hz)"
        depends on IDF_TARGET_ESP32S31
        default 40000000
        help
          厂商示例使用 40MHz; 首次点亮可先用 10MHz 排除时序问题。
          CO5300 数据手册的写时钟周期至少为 20ns。

    config ESP_CUBE_LCD_H_RES
        int "面板水平分辨率"
        default 460

    config ESP_CUBE_LCD_V_RES
        int "面板垂直分辨率"
        default 460

endmenu
